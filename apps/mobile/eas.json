{
  "cli": {
    "version": "27.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.21.0",
      "env": {
        "EXPO_PUBLIC_ALLOW_INSECURE_HTTP": "false"
      },
      "android": {
        "image": "sdk-58",
        "buildType": "apk"
      }
    },
    "android-validation": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "node": "24.21.0",
      "env": {
        "FIELDOPS_ANDROID_VALIDATION": "1",
        "EXPO_PUBLIC_ALLOW_INSECURE_HTTP": "false"
      },
      "android": {
        "image": "sdk-58",
        "buildType": "apk"
      }
    }
  }
}
