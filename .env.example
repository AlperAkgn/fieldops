# Local Docker development only. Copy to .env and choose your own passwords.
# Never use these example credentials in a shared or production environment.
POSTGRES_DB=fieldops
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=fieldops_dev_change_me
POSTGRES_PORT=5432
API_PORT=5080
MINIO_ROOT_USER=fieldops_local
MINIO_ROOT_PASSWORD=fieldops_minio_dev_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Frontend tools read their own project-local env files, not this root file.
# API URLs must be HTTP(S) origins only, without credentials, paths, queries, or fragments.
# apps/admin-web/.env.local:
# VITE_API_BASE_URL=http://localhost:5080
# apps/mobile/.env.local (replace localhost with the host LAN IP on a phone):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5080

