# Public client configuration only. Never put tokens, passwords or signing keys here.
# Production and physical-device builds require a trusted device-reachable HTTPS origin.
EXPO_PUBLIC_API_BASE_URL=https://localhost:5443
# Debug builds only: opt in explicitly for private local HTTP (e.g. Android 10.0.2.2:5080).
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false
