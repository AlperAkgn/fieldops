{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["react", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "integration/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "vitest*.mts",
    "jest.setup.ts"
  ]
}
